# Create a dedicated bot in @BotFather; leave webhook disabled.
BOT_TOKEN=
# Your numeric Telegram IDs, up to five, comma separated. No automatic first-user access.
OWNER_IDS=
REPORT_TITLE=Аналитика
DASHBOARD_URL=https://dashboard.example.com
REDIS_URL=redis://localhost:6379
TIMEZONE=Europe/Moscow
PLATFORMS=all:Все,web:Web,app:Приложение
# demo = generated synthetic data, http = your read-only JSON endpoint.
METRICS_MODE=demo
METRICS_URL=
METRICS_BEARER_TOKEN=
# HTTP is allowed only for localhost or the exact container host demo-source.
METRICS_MAX_AGE_SECONDS=900
USD_RUB_RATE=85
# Finance/domain reminders are disabled in demo mode.
FINANCE_REMINDERS_ENABLED=true
LOW_BALANCE_DAYS=5
# Optional: routable IPv4 address for api.telegram.org; TLS/SNI remain unchanged.
TELEGRAM_CONNECT_IPV4=
HEALTH_PORT=3000
